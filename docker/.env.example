CARTAVAULT_VERSION=1.0.0-rc.4
CARTAVAULT_HTTP_PORT=8088
CARTAVAULT_IMAGE=ghcr.io/flynx9/cartavault

POSTGRES_DB=cartavault
POSTGRES_USER=cartavault
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://cartavault:replace-with-url-encoded-password@postgis:5432/cartavault

FRONTEND_PUBLIC_URL=https://cartavault.example.com
CORS_ALLOWED_ORIGINS=https://cartavault.example.com
CARTAVAULT_COOKIE_SECURE=true
# Leave empty for direct exposure. Behind a reverse proxy, list only its exact
# IP address or CIDR range. The wildcard value "*" is rejected.
CARTAVAULT_FORWARDED_ALLOW_IPS=
CARTAVAULT_SESSION_SECRET=
CARTAVAULT_SETUP_TOKEN=
CARTAVAULT_CREDENTIALS_ENCRYPTION_KEY=
# The standard mono-instance stack runs tasks synchronously and does not need
# Redis. Define these only with compose.redis.yml or compose.portainer.redis.yml.
# REDIS_PASSWORD=replace-with-a-second-long-random-password
# CARTAVAULT_TASK_QUEUE=cartavault
CARTAVAULT_GOOGLE_ROUTES_REQUESTS_PER_MINUTE=120
CARTAVAULT_GOOGLE_ROUTES_RATE_WINDOW_SECONDS=60
CARTAVAULT_ROUTING_PROPOSAL_TTL_SECONDS=900

# Bounded application startup and Alembic migration.
CARTAVAULT_DATABASE_READY_TIMEOUT_SECONDS=120
CARTAVAULT_DATABASE_STABLE_CHECKS=3
CARTAVAULT_DATABASE_CONNECT_TIMEOUT_SECONDS=5
CARTAVAULT_MIGRATION_LOCK_TIMEOUT_SECONDS=300

CARTAVAULT_REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org
CARTAVAULT_REVERSE_GEOCODING_USER_AGENT=CartaVault/1.0 (self-hosted POI manager)
CARTAVAULT_REVERSE_GEOCODING_TIMEOUT_SECONDS=8
CARTAVAULT_REVERSE_GEOCODING_MIN_INTERVAL_SECONDS=1

EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=CartaVault
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=
EMAIL_PROVIDER_TIMEOUT_SECONDS=10
EMAIL_PROVIDER_MAX_ATTEMPTS=2
EMAIL_PROVIDER_RETRY_DELAY_SECONDS=1
# Generic SMTP (required only when EMAIL_PROVIDER=smtp).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURITY=starttls
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# Optional legacy bootstrap. New installations use the web setup wizard.
CARTAVAULT_BOOTSTRAP_ADMIN_EMAIL=
CARTAVAULT_BOOTSTRAP_ADMIN_NAME=
CARTAVAULT_BOOTSTRAP_ADMIN_PASSWORD=

# Optional build-time geocoding key.
