CARTAVAULT_VERSION=1.0.0
CARTAVAULT_HTTP_PORT=8088

POSTGRES_DB=cartavault
POSTGRES_USER=cartavault
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://cartavault:replace-with-url-encoded-password@postgres:5432/cartavault

FRONTEND_PUBLIC_URL=https://cartavault.example.com
CORS_ALLOWED_ORIGINS=https://cartavault.example.com
CARTAVAULT_COOKIE_SECURE=true
CARTAVAULT_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=CartaVault
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=

CARTAVAULT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CARTAVAULT_BOOTSTRAP_ADMIN_NAME=Administrator
CARTAVAULT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional build-time geocoding key.
VITE_STADIA_MAPS_API_KEY=
