# Laisser vide en local pour utiliser le proxy Vite /api vers 127.0.0.1:8000.
VITE_API_BASE_URL=
# Instance fallback used after the browser language when no account preference exists.
VITE_DEFAULT_LANGUAGE=fr
# OSM raster is retained as a technical fallback and for simple raster previews.
VITE_BASEMAP_OSM_ENABLED=true
# Locally hosted CartaVault styles. Their vector data always comes from the
# country PMTiles library managed by the CartaVault backend.
# Online OpenFreeMap styles are loaded directly by the browser.
VITE_OPENFREEMAP_LIGHT_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_OPENFREEMAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/dark
VITE_BASEMAP_LIGHT_STYLE_URL=/map-styles/cartavault-light.json
VITE_BASEMAP_DARK_STYLE_URL=/map-styles/cartavault-dark.json
VITE_OFFLINE_VECTOR_GLYPHS_URL=/api/basemaps/cartavault/fonts/{fontstack}/{range}.pbf
# OSM Standard is the controlled fallback.
VITE_BASEMAP_OSM_URL=
