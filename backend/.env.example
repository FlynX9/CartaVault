DATABASE_URL=postgresql+psycopg://poi_user:change_me@localhost:5432/cartavault
CARTAVAULT_DATABASE_CONNECT_TIMEOUT_SECONDS=5
CARTAVAULT_VERSION=1.0.0
PHOTO_STORAGE_PATH=storage/photos
AVATAR_STORAGE_PATH=storage/avatars
# Optional private S3-compatible photo storage (local remains the default).
MEDIA_STORAGE=local
MEDIA_CACHE_PATH=storage/media-cache
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=media
S3_FORCE_PATH_STYLE=false
S3_USE_SSL=true
S3_VERIFY_TLS=true
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30
S3_MAX_ATTEMPTS=3
S3_OPERATION_TIMEOUT_SECONDS=300
S3_RETRY_MODE=standard
# Maintenance leader supervision uses a dedicated checked-out PostgreSQL
# connection and retries session-lock acquisition after disconnects.
CARTAVAULT_MAINTENANCE_LEADER_CHECK_INTERVAL_SECONDS=2
CARTAVAULT_MAINTENANCE_LEADER_RECONNECT_INITIAL_SECONDS=1
CARTAVAULT_MAINTENANCE_LEADER_RECONNECT_MAX_SECONDS=15
CARTAVAULT_MAINTENANCE_LEADER_RECONNECT_JITTER_SECONDS=1
CARTAVAULT_MAINTENANCE_PURGE_INTERVAL_SECONDS=3600
# Bounded DB/blob reconciliation. Deep scans are operator-triggered with
# `python -m app.cli storage-reconcile` (dry-run) or `--repair`.
CARTAVAULT_STORAGE_RECONCILE_INTERVAL_SECONDS=60
CARTAVAULT_STORAGE_RECONCILE_BATCH_SIZE=50
CARTAVAULT_STORAGE_ORPHAN_GRACE_SECONDS=86400
CARTAVAULT_STORAGE_DELETE_MAX_ATTEMPTS=8
CARTAVAULT_STORAGE_DELETE_BASE_BACKOFF_SECONDS=30
CARTAVAULT_STORAGE_DELETE_CAP_BACKOFF_SECONDS=3600

# Fond OpenStreetMap des exports PDF (cache persistant recommandé en production)
CARTAVAULT_PDF_MAP_TILES_ENABLED=true
CARTAVAULT_PDF_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
CARTAVAULT_PDF_MAP_TILE_CACHE=/app/storage/exports/pdf-map-tiles

# Routing (public demo server; deploy a private/managed OSRM for production)
OSRM_BASE_URL=https://router.project-osrm.org
KMZ_MAX_IMAGES=500
KMZ_MAX_ENTRIES=750
OSRM_TIMEOUT_SECONDS=12
OSRM_MAX_WAYPOINTS=50
OSRM_PROFILE=driving

# OpenRouteService optionnel. Les clés publiques sont stockées par utilisateur.
CARTAVAULT_ORS_ENABLED=true
CARTAVAULT_ORS_BASE_URL=https://api.openrouteservice.org
CARTAVAULT_ORS_TIMEOUT_SECONDS=15
CARTAVAULT_ORS_MAX_WAYPOINTS=50
CARTAVAULT_ORS_REQUESTS_PER_MINUTE=40
CARTAVAULT_ORS_FALLBACK_TO_OSRM=true
# Réserver `true` à une instance ORS auto-hébergée de confiance.
CARTAVAULT_ORS_ALLOW_UNAUTHENTICATED=false

# Reverse geocoding (OpenStreetMap Nominatim by default)
CARTAVAULT_REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org
CARTAVAULT_REVERSE_GEOCODING_USER_AGENT=CartaVault/0.1 (self-hosted POI manager)
CARTAVAULT_REVERSE_GEOCODING_TIMEOUT_SECONDS=8
CARTAVAULT_REVERSE_GEOCODING_MIN_INTERVAL_SECONDS=1
# Infrastructure-only local development paths. Functional vector settings are
# persisted and edited from Administration > General.
CARTAVAULT_VECTOR_MAP_DIR=D:/cartavault/maps
CARTAVAULT_VECTOR_MAP_FONTS_PATH=D:/cartavault/maps/fonts
CARTAVAULT_PLANETILER_JAR=D:/cartavault/tools/planetiler-openmaptiles.jar
CARTAVAULT_PLANETILER_TIMEOUT_SECONDS=21600
CARTAVAULT_ARCGIS_API_KEY=
CARTAVAULT_ARCGIS_TIMEOUT_SECONDS=10
CARTAVAULT_ARCGIS_SESSION_DURATION_SECONDS=43200
CARTAVAULT_JAVA_EXECUTABLE=D:/cartavault/tools/java21/bin/java.exe
# Obsolète : uniquement détectée pour avertir, jamais utilisée pour router.
GOOGLE_MAPS_ROUTES_API_KEY=
# Clé Fernet maîtresse de l’instance ; à fournir via un secret de déploiement.
CARTAVAULT_CREDENTIALS_ENCRYPTION_KEY=
GOOGLE_MAPS_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_MAPS_ROUTES_TIMEOUT_SECONDS=15
GOOGLE_MAPS_ROUTES_CONNECT_TIMEOUT_SECONDS=5
CARTAVAULT_GOOGLE_ROUTES_REQUESTS_PER_MINUTE=120
CARTAVAULT_GOOGLE_ROUTES_RATE_WINDOW_SECONDS=60
CARTAVAULT_ROUTING_PROPOSAL_TTL_SECONDS=900
TEST_DATABASE_URL=postgresql+psycopg://poi_user:change_me@localhost:5432/cartavault_test
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CARTAVAULT_API_ROOT_PATH=
CARTAVAULT_SESSION_COOKIE_NAME=cartavault_session
CARTAVAULT_CSRF_COOKIE_NAME=cartavault_csrf
CARTAVAULT_SESSION_DAYS=14
# Précision maximale de last_used_at et intervalle minimal entre deux écritures.
CARTAVAULT_SESSION_ACTIVITY_WRITE_INTERVAL_SECONDS=300
CARTAVAULT_INVITATION_HOURS=168
CARTAVAULT_COOKIE_SECURE=false
CARTAVAULT_PASSWORD_MIN_LENGTH=12
CARTAVAULT_ARGON2_TIME_COST=3
CARTAVAULT_ARGON2_MEMORY_COST=65536
CARTAVAULT_ARGON2_PARALLELISM=4
# Bootstrap non interactif optionnel. Ne jamais versionner de vraies valeurs.
CARTAVAULT_BOOTSTRAP_ADMIN_EMAIL=
CARTAVAULT_BOOTSTRAP_ADMIN_NAME=
CARTAVAULT_BOOTSTRAP_ADMIN_PASSWORD=
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=CartaVault
EMAIL_FROM_ADDRESS=no-reply@cartavault.fr
EMAIL_REPLY_TO=contact@cartavault.fr
# Required only with EMAIL_PROVIDER=smtp.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURITY=starttls
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
FRONTEND_PUBLIC_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_PROVIDER_TIMEOUT_SECONDS=10
EMAIL_PROVIDER_MAX_ATTEMPTS=2
EMAIL_PROVIDER_RETRY_DELAY_SECONDS=1
