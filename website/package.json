{
  "name": "website",
  "type": "module",
  "version": "1.0.0-rc.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-deployment.mjs public dist",
    "build:prod": "node scripts/build-deployment.mjs public dist-prod",
    "build:preprod": "node scripts/build-deployment.mjs preprod dist-preprod",
    "build:release": "node scripts/build-deployment.mjs public dist-release",
    "check": "astro check",
    "verify": "npm run docs:check && npm run verify:site",
    "verify:site": "npm run check && npm run build",
    "docs:dev": "astro dev",
    "docs:generate": "node scripts/run-docs.mjs",
    "docs:check": "node scripts/run-docs.mjs --check",
    "docs:discover": "node scripts/run-docs.mjs",
    "docs:capture": "docker compose -f ../demo/compose.yml --profile screenshots run --build --rm screenshots && node scripts/run-python.mjs scripts/docs/sync_screenshots.py",
    "docs:screenshots": "npm run docs:capture",
    "docs:build": "npm run docs:generate && npm run build",
    "docs:refresh": "npm run docs:generate && npm run docs:capture && npm run docs:generate && npm run docs:check && npm run build",
    "demo:reset": "docker compose -f ../demo/compose.yml run --rm demo-reset reset",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "@lucide/astro": "^1.28.0",
    "astro": "^7.1.6",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3"
  }
}
