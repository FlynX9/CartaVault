---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BrowserFrame from './BrowserFrame.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  label: string;
  caption?: string;
  eager?: boolean;
  compact?: boolean;
  position?: 'left' | 'center' | 'right';
}
const { image, alt, label, caption, eager = false, compact = false, position = 'left' } = Astro.props;
---
<figure class:list={['product-screenshot', `product-screenshot--${position}`]}>
  <BrowserFrame label={label} compact={compact}>
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1440]}
      sizes="(max-width: 760px) 94vw, (max-width: 1100px) 88vw, 720px"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      quality={86}
    />
  </BrowserFrame>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
