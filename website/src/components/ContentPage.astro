---
import { copy, external, type Language, type PageSlug } from '../content/site';
const { lang, slug } = Astro.props as { lang: Language; slug: PageSlug };
const page = copy[lang].pages[slug];
const specialHref = slug === 'contact' ? external.email : slug === 'documentation' ? external.docs : slug === 'roadmap' ? external.issues : null;
---
<header class="page-hero wrap"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="lead">{page.description}</p>{specialHref && <a class="button" href={specialHref}>{slug === 'contact' ? (lang === 'fr' ? 'Écrire un e-mail' : 'Send an email') : slug === 'roadmap' ? (lang === 'fr' ? 'Voir les issues' : 'View issues') : (lang === 'fr' ? 'Ouvrir les guides' : 'Open the guides')} <span aria-hidden="true">↗</span></a>}</header>
<div class="content-grid wrap">{page.sections.map((section, index) => <section class="content-card"><span class="section-number">{String(index + 1).padStart(2, '0')}</span><h2>{section.title}</h2><p>{section.body}</p>{section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}</section>)}</div>
