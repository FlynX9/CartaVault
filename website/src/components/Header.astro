---
import { ArrowUpRight, ChevronDown, Info, Menu, X } from '@lucide/astro';
import { copy, external, href, type Language } from '../content/site';
interface Props { lang: Language; other: Language; path: string; }
const { lang, other, path } = Astro.props;
const text = copy[lang];
---
<header class="site-header">
  <a class="brand" href={href(lang)} aria-label={lang === 'fr' ? 'CartaVault — accueil' : 'CartaVault — home'}>
    <img src="/images/cartavault-logo.png" width="38" height="38" alt="" />
    <span>CartaVault</span>
  </a>
  <nav class="desktop-nav" aria-label={text.navLabel}>
    {Object.entries(text.nav).map(([slug, label]) => <a href={href(lang, slug)} aria-current={path === slug ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div class="header-actions">
    <a class="language" href={href(other, path)} lang={other} aria-label={lang === 'fr' ? 'Afficher le site en anglais' : 'View the site in French'}>{text.language}<ChevronDown size={13} aria-hidden="true" /></a>
    <button class="button small app-button" type="button" data-beta-app-open>{text.openApp}<ArrowUpRight size={15} aria-hidden="true" /></button>
    <details class="mobile-menu">
      <summary aria-label={text.menu}><Menu class="mobile-menu__open" size={21} aria-hidden="true" /><X class="mobile-menu__close" size={21} aria-hidden="true" /></summary>
      <div class="mobile-menu__panel">
        <nav aria-label={text.navLabel}>
          {Object.entries(text.nav).map(([slug, label]) => <a href={href(lang, slug)} aria-current={path === slug ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div><a class="language" href={href(other, path)} lang={other}>{text.language}</a><button class="button small" type="button" data-beta-app-open>{text.openApp}<ArrowUpRight size={15} aria-hidden="true" /></button></div>
      </div>
    </details>
  </div>
</header>

<dialog class="beta-app-dialog" data-beta-app-dialog aria-labelledby="beta-app-title">
  <form method="dialog" class="beta-app-dialog__panel">
    <button class="beta-app-dialog__close" type="submit" value="cancel" aria-label={text.close}><X size={20} aria-hidden="true" /></button>
    <div class="beta-app-dialog__icon"><Info size={24} aria-hidden="true" /></div>
    <p class="eyebrow">{text.beta.eyebrow}</p>
    <h2 id="beta-app-title">{text.beta.title}</h2>
    <p>{text.beta.body}</p>
    <div class="beta-app-dialog__actions">
      <button class="button secondary small" type="submit" value="cancel">{text.beta.cancel}</button>
      <a class="button small" href={external.app}>{text.beta.accept}<ArrowUpRight size={15} aria-hidden="true" /></a>
    </div>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-beta-app-dialog]');
  document.querySelectorAll<HTMLButtonElement>('[data-beta-app-open]').forEach((button) => {
    button.addEventListener('click', () => dialog?.showModal());
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close('cancel');
  });
</script>
