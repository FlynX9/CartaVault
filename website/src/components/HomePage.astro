---
import { ArrowRight, ArrowUpRight, Database, LockKeyhole, Server } from '@lucide/astro';
import appAccount from '../assets/screenshots/app-account.webp';
import appMedia from '../assets/screenshots/app-media.webp';
import appPlaces from '../assets/screenshots/app-places.webp';
import appPopup from '../assets/screenshots/app-place-popup.webp';
import appTrip from '../assets/screenshots/app-trip.webp';
import { copy, external, href, type Language } from '../content/site';
import ProductScreenshot from './ProductScreenshot.astro';
import SectionEyebrow from './SectionEyebrow.astro';

const { lang } = Astro.props as { lang: Language };
const t = copy[lang].home;
---
<section class="home-hero wide-wrap">
  <div class="home-hero__copy">
    <SectionEyebrow label={t.eyebrow} />
    <h1>{t.hero}</h1>
    <p class="lead">{t.intro}</p>
    <div class="actions">
      <a class="button" href={external.github}>{t.primary}<ArrowUpRight size={16} aria-hidden="true" /></a>
      <a class="button secondary" href={href(lang, 'features')}>{t.secondary}<ArrowRight size={16} aria-hidden="true" /></a>
    </div>
  </div>
  <ProductScreenshot image={appPlaces} alt={lang === 'fr' ? 'Carte et liste de lieux illustrés dans CartaVault' : 'Map and illustrated place list in CartaVault'} label={lang === 'fr' ? 'Espace cartographique' : 'Mapping workspace'} eager />
</section>

<section class="proof-bar wrap" aria-label={lang === 'fr' ? 'Caractéristiques techniques' : 'Technical characteristics'}>
  {t.proof.map((item, index) => <div><span aria-hidden="true">{index === 0 ? <LockKeyhole size={17} /> : index === 1 ? <Database size={17} /> : <Server size={17} />}</span><strong>{item}</strong></div>)}
</section>

<section class="home-feature wrap">
  <div class="home-feature__copy"><SectionEyebrow label={`01 · ${lang === 'fr' ? 'Collecter' : 'Collect'}`} /><h2>{t.placesTitle}</h2><p>{t.placesBody}</p><a class="text-link" href={href(lang, 'features')}>{lang === 'fr' ? 'Explorer les cartes et lieux' : 'Explore maps and places'}<ArrowRight size={15} aria-hidden="true" /></a></div>
  <ProductScreenshot image={appPopup} alt={lang === 'fr' ? 'Fiche détaillée et illustrée d’un lieu' : 'Detailed and illustrated place record'} label={lang === 'fr' ? 'Fiche d’un lieu' : 'Place details'} compact />
</section>

<section class="home-feature-band">
  <div class="home-feature home-feature--reverse wrap">
    <div class="home-feature__copy"><SectionEyebrow label={`02 · ${lang === 'fr' ? 'Planifier' : 'Plan'}`} /><h2>{t.tripsTitle}</h2><p>{t.tripsBody}</p><a class="text-link" href={href(lang, 'features')}>{lang === 'fr' ? 'Explorer les sorties et voyages' : 'Explore trips and outings'}<ArrowRight size={15} aria-hidden="true" /></a></div>
    <ProductScreenshot image={appTrip} alt={lang === 'fr' ? 'Préparation détaillée d’une sortie' : 'Detailed trip planning'} label={lang === 'fr' ? 'Préparation de la sortie' : 'Trip planning'} />
  </div>
</section>

<section class="home-principles wrap">
  <article><span aria-hidden="true"><LockKeyhole size={21} /></span><div><SectionEyebrow label="03 · Collaboration" /><h2>{t.collaborationTitle}</h2><p>{t.collaborationBody}</p></div></article>
  <article><span aria-hidden="true"><Server size={21} /></span><div><SectionEyebrow label={`04 · ${lang === 'fr' ? 'Hébergement' : 'Hosting'}`} /><h2>{t.hostingTitle}</h2><p>{t.hostingBody}</p><div class="chips"><span>{t.self}</span><span class="planned">{t.cloud}</span></div></div></article>
</section>

<section class="interface-section wide-wrap">
  <div class="interface-section__heading"><div><SectionEyebrow label={lang === 'fr' ? 'Interface réelle' : 'Real interface'} /><h2>{t.screenshotsTitle}</h2></div><p>{lang === 'fr' ? 'Des écrans conçus pour rester lisibles, des grandes cartes jusqu’aux réglages personnels.' : 'Screens designed to remain readable, from large maps to personal settings.'}</p></div>
  <div class="interface-gallery">
    <ProductScreenshot image={appMedia} alt={lang === 'fr' ? 'Médiathèque CartaVault' : 'CartaVault media library'} label={lang === 'fr' ? 'Médiathèque' : 'Media library'} compact />
    <ProductScreenshot image={appAccount} alt={lang === 'fr' ? 'Préférences du compte CartaVault' : 'CartaVault account preferences'} label={lang === 'fr' ? 'Préférences du compte' : 'Account preferences'} compact />
  </div>
</section>

<section class="cta wrap"><div><SectionEyebrow label="Open source" /><h2>{t.ctaTitle}</h2><p>{t.ctaBody}</p></div><div class="actions"><a class="button" href={external.github}>GitHub<ArrowUpRight size={16} aria-hidden="true" /></a><a class="button secondary" href={external.docs}>{lang === 'fr' ? 'Documentation' : 'Documentation'}<ArrowRight size={16} aria-hidden="true" /></a></div></section>
