---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePage.astro';
import { copy, languages, type Language } from '../../content/site';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const page = copy[lang].home;
---
<BaseLayout lang={lang} title={page.title} description={page.description}><HomePage lang={lang} /></BaseLayout>
