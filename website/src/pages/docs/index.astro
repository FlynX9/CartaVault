---
import { isIndexableDeployment } from '../../seo';
const target = '/docs/fr/';
---
<!doctype html><html lang="fr"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0;url=${target}`} /><meta name="robots" content={isIndexableDeployment ? 'index,follow' : 'noindex,nofollow'} />{isIndexableDeployment && <link rel="canonical" href={new URL(target, Astro.site)} />}<title>Documentation CartaVault</title></head><body><a href={target}>Continuer vers la documentation CartaVault</a></body></html>
