---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { X } from '@lucide/astro';
import '../styles/global.css';
import { copy, href, type Language } from '../content/site';

interface Props { lang: Language; title: string; description: string; path?: string; image?: string; indexable?: boolean; }
const { lang, title, description, path = '', image, indexable = true } = Astro.props;
const deploymentIsIndexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true';
const pageIsIndexable = indexable && deploymentIsIndexable;
const socialImage = image ?? `/images/app-places-${lang}.webp`;
const canonical = new URL(href(lang, path), Astro.site);
const other = lang === 'fr' ? 'en' : 'fr';
const structured = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'CartaVault',
  applicationCategory: 'TravelApplication', operatingSystem: 'Web', url: canonical.toString(),
  description, license: 'https://opensource.org/license/mit',
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0d1b2a" />
    <meta name="description" content={description} />
    <meta name="robots" content={pageIsIndexable ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'} />
    {pageIsIndexable && <link rel="canonical" href={canonical} />}
    {pageIsIndexable && <link rel="alternate" hreflang="fr" href={new URL(href('fr', path), Astro.site)} />}
    {pageIsIndexable && <link rel="alternate" hreflang="en" href={new URL(href('en', path), Astro.site)} />}
    {pageIsIndexable && <link rel="alternate" hreflang="x-default" href={new URL(href('fr', path), Astro.site)} />}
    <link rel="icon" type="image/png" sizes="200x200" href="/favicon-v2.png" />
    <link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CartaVault" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(socialImage, Astro.site)} />
    {pageIsIndexable && <script is:inline type="application/ld+json" set:html={JSON.stringify(structured)} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{copy[lang].skip}</a>
    <Header lang={lang} other={other} path={path} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <dialog class="screenshot-lightbox" id="screenshot-lightbox" aria-labelledby="screenshot-lightbox-title">
      <div class="screenshot-lightbox__surface">
        <header>
          <p id="screenshot-lightbox-title"></p>
          <button type="button" data-screenshot-close aria-label={lang === 'fr' ? 'Fermer l’image agrandie' : 'Close enlarged image'}><X size={18} aria-hidden="true" /></button>
        </header>
        <div class="screenshot-lightbox__viewport"><img alt="" /></div>
      </div>
    </dialog>
    <script is:inline>
      const lightbox = document.querySelector('#screenshot-lightbox');
      if (lightbox instanceof HTMLDialogElement) {
        const image = lightbox.querySelector('img');
        const title = lightbox.querySelector('#screenshot-lightbox-title');
        document.querySelectorAll('[data-screenshot-open]').forEach((trigger) => {
          trigger.addEventListener('click', () => {
            if (!(trigger instanceof HTMLElement) || !(image instanceof HTMLImageElement) || !(title instanceof HTMLElement)) return;
            image.src = trigger.dataset.screenshotSrc ?? '';
            image.alt = trigger.dataset.screenshotAlt ?? '';
            title.textContent = trigger.dataset.screenshotLabel ?? '';
            lightbox.showModal();
          });
        });
        lightbox.querySelector('[data-screenshot-close]')?.addEventListener('click', () => lightbox.close());
        lightbox.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
        lightbox.addEventListener('close', () => { if (image instanceof HTMLImageElement) image.removeAttribute('src'); });
      }
    </script>
  </body>
</html>
